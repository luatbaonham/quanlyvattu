<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="12dp"
    app:cardElevation="8dp"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/card_background">

        <TextView
            android:id="@+id/tvMaPhieu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📄 Mã phiếu: 123"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/tvNguoiMuon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🙍‍♂️ Người mượn: ndtien142"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:layout_marginTop="7dp" />

        <TextView
            android:id="@+id/tvPhong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🏢 Phòng: PHÒNG QUẢN TRỊ"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvNgayTao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🗓️ Ngày tạo: 2025-06-03"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvSoLuong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔢 Tổng SL: 5"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvTrangThai"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✅ Trạng thái: Đang mượn"
            android:textSize="14sp"
            android:textColor="@color/teal_700"
            android:layout_marginTop="6dp"
            android:background="@drawable/status_background"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:layout_gravity="end" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScan"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Quét mã"
                android:textColor="@color/white"
                app:icon="@drawable/ic_qr_code"
                app:iconTint="@color/white"
                app:backgroundTint="@color/teal_700"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <Button
                android:id="@+id/btnUpdateStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Cập nhật"
                android:textColor="@color/white"
                android:backgroundTint="@color/purple_500" />
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>